NODE_ENV=development
PORT=3000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=quickfiller
MYSQL_PASSWORD=quickfiller
MYSQL_DATABASE=quickfiller

# Upload & storage
MAX_UPLOAD_BYTES=10485760
STORAGE_DIR=storage
RETENTION_HOURS=24

# S3 permanent PDF storage (leave bucket empty to use local storage)
AWS_REGION=us-east-2
S3_BUCKET_NAME=
S3_PREFIX=pdfs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Processing
OCR_LANGUAGE=por
OCR_TIMEOUT_MS=120000
PDF_PARSE_TIMEOUT_MS=60000
MIN_TEXT_LENGTH=20
WORKER_POLL_MS=2000
WORKER_LOCK_TIMEOUT_MS=300000

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
