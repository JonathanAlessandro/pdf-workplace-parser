{
  "name": "quick-filler-desafio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quick Filler - transcrição de PDFs trabalhistas",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/transcriptionWorker.js",
    "migrate": "node migrations/run.js",
    "lint": "eslint src tests migrations",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node -e \"console.log('No build step required')\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  }
}
